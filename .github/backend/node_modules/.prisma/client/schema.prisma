// Prisma schema for Alince Logistics ERP
// PostgreSQL 16/17 backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdempotencyKey {
  key       String   @id
  path      String
  body      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

enum PageKey {
  dashboard
  shipments
  weightproforma
  ledger
  alerts
  reports
  cartons
  expenses
  users_management @map("users-management")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  passwordHash String    @map("password_hash")
  permissions  PageKey[]
  isProtected  Boolean   @default(false) @map("is_protected")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]
  expenses  Expense[]  @relation("ExpenseCreatedBy")

  @@map("users")
}

// ─── Customers & Vendors ──────────────────────────────────────────────────────

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String   @default("")
  email          String   @default("")
  city           String   @default("")
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditDays     Int      @default(30) @map("credit_days")
  accountCode    String   @default("") @map("account_code")
  branch         String   @default("")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shipments     Shipment[]
  ledgerEntries CustomerLedgerEntry[]

  @@map("customers")
}

enum VendorCategory {
  COURIER_FREIGHT @map("Courier / Freight")
  FUEL            @map("Fuel")
  OFFICE_SUPPLIES @map("Office Supplies")
  UTILITIES       @map("Utilities")
  RENT            @map("Rent")
  MAINTENANCE     @map("Maintenance")
  OTHER           @map("Other")
}

model Vendor {
  id             Int            @id @default(autoincrement())
  name           String
  phone          String         @default("")
  email          String         @default("")
  city           String         @default("")
  category       VendorCategory @default(COURIER_FREIGHT)
  creditDays     Int            @default(30) @map("credit_days")
  accountCode    String         @default("") @map("account_code")
  branch         String         @default("")
  openingBalance Decimal        @default(0) @map("opening_balance") @db.Decimal(14, 2)
  services       String[]       @default([])
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  ledgerEntries VendorLedgerEntry[]

  @@map("vendors")
}

// ─── Shipments ────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  Pending
  Shipped
  Delivered
  Returned
}

model Shipment {
  id           Int            @id @default(autoincrement())
  date         String // "YYYY-MM-DD"
  customerId   Int?           @map("customer_id")
  customerName String         @map("customer_name")
  isWalkIn     Boolean        @default(false) @map("is_walk_in")
  walkInName   String?        @map("walk_in_name")
  courier      String
  service      String         @default("Express")
  awb          String         @unique
  origin       String         @default("")
  destination  String
  pieces       Int            @default(1)
  weight       Decimal        @db.Decimal(10, 3)
  shipInv      String?        @map("ship_inv")
  jobNo        String?        @map("job_no")
  revenue      Decimal        @db.Decimal(14, 2)
  cost         Decimal        @db.Decimal(14, 2)
  status       ShipmentStatus @default(Pending)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  customer    Customer?        @relation(fields: [customerId], references: [id])
  cartonsUsed CartonMovement[] @relation("ShipmentCartons")

  @@index([date])
  @@index([customerId])
  @@map("shipments")
}

// ─── Ledger ───────────────────────────────────────────────────────────────────

enum CustomerVoucherType {
  AE_LOC_INV @map("AE-LOC-INV")
  AI_LOC_INV @map("AI-LOC-INV")
  BRV
  CRV
  JVR
}

enum VendorVoucherType {
  PINV
  EXP_INV @map("EXP-INV")
  BPV
  CPV
  JVR
}

model VoucherCounter {
  id          Int    @id @default(autoincrement())
  voucherType String @unique @map("voucher_type")
  lastNumber  Int    @default(1000) @map("last_number")

  @@map("voucher_counters")
}

model CustomerLedgerEntry {
  id          Int                 @id @default(autoincrement())
  customerId  Int                 @map("customer_id")
  date        String
  description String
  type        String // "debit" | "credit"
  amount      Decimal             @db.Decimal(14, 2)
  voucherType CustomerVoucherType @map("voucher_type")
  voucherNo   String              @map("voucher_no")
  jobNo       String?             @map("job_no")
  shipInv     String?             @map("ship_inv")
  branch      String?
  orig        String?
  dest        String?
  pcsWeight   String?             @map("pcs_weight")
  chequeNo    String?             @map("cheque_no")
  chequeDate  String?             @map("cheque_date")
  createdAt   DateTime            @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([date])
  @@map("customer_ledger")
}

model VendorLedgerEntry {
  id          Int               @id @default(autoincrement())
  vendorId    Int               @map("vendor_id")
  date        String
  description String
  type        String // "debit" | "credit"
  amount      Decimal           @db.Decimal(14, 2)
  voucherType VendorVoucherType @map("voucher_type")
  voucherNo   String            @map("voucher_no")
  jobNo       String?           @map("job_no")
  chequeNo    String?           @map("cheque_no")
  chequeDate  String?           @map("cheque_date")
  createdAt   DateTime          @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("vendor_ledger")
}

// ─── Weight Proforma ──────────────────────────────────────────────────────────

model WeightProforma {
  id         Int      @id @default(autoincrement())
  cnNo       String   @map("cn_no")
  shipper    String
  services   String
  date       String
  divisor    Int      @default(5000)
  shipmentId Int?     @map("shipment_id")
  boxes      Json // WeightBox[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("weight_proformas")
}

// ─── Cartons ──────────────────────────────────────────────────────────────────

model CartonType {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  lengthCm          Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm           Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm          Decimal? @map("height_cm") @db.Decimal(8, 2)
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  movements CartonMovement[]

  @@map("carton_types")
}

enum MovementType {
  RECEIVED
  USED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURNED
}

model CartonMovement {
  id           Int          @id @default(autoincrement())
  cartonTypeId Int          @map("carton_type_id")
  date         String
  movementType MovementType @map("movement_type")
  quantity     Int
  shipmentId   Int?         @map("shipment_id")
  vendorId     Int?         @map("vendor_id")
  unitCost     Decimal?     @map("unit_cost") @db.Decimal(14, 2)
  note         String?
  createdBy    String       @default("system") @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  cartonType CartonType @relation(fields: [cartonTypeId], references: [id])
  shipment   Shipment?  @relation("ShipmentCartons", fields: [shipmentId], references: [id])

  @@index([cartonTypeId])
  @@index([shipmentId])
  @@map("carton_movements")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  expenses Expense[]

  @@map("expense_categories")
}

enum ExpensePaymentMethod {
  Cash
  Bank_Transfer @map("Bank Transfer")
  Online
  Easypaisa
  JazzCash
}

model Expense {
  id            Int                  @id @default(autoincrement())
  date          String
  categoryId    Int                  @map("category_id")
  amount        Decimal              @db.Decimal(14, 2)
  description   String
  paidTo        String?              @map("paid_to")
  paymentMethod ExpensePaymentMethod @default(Cash) @map("payment_method")
  referenceNo   String?              @map("reference_no")
  createdById   Int?                 @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([date])
  @@index([categoryId])
  @@map("expenses")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
